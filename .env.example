# Copy to .env and fill in. Never commit .env.
# Comments must be on their own line (no inline comments after values).

# --- App ---
# development | production (production enables Secure cookies and serves frontend/dist)
APP_ENV=development
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
API_HOST=127.0.0.1
API_PORT=8000
# Comma-separated; only needed when not using the Vite proxy
CORS_ORIGINS=http://localhost:5173

# --- Storage (paths are relative to the repo root; gitignored) ---
DATA_DIR=./backend/data
DATABASE_URL=sqlite:///./backend/data/app.db
FILES_DIR=./backend/data/files
MAX_UPLOAD_MB=50
# Policy rules (JSON / YAML), re-read on every audit — edit and click Re-run audit
POLICY_DIR=./policies

# --- Auth ---
# Generate: python3 -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-64-char-random-string
JWT_EXPIRE_MINUTES=720
# Seeded on first start when no users exist
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong-password
ADMIN_NAME=Admin

# --- LLM ---
# auto = Claude when ANTHROPIC_API_KEY is set, otherwise the offline rule-based provider
# anthropic = always Claude; offline = never call an external API (demo / no key)
LLM_PROVIDER=auto
LLM_MODEL=claude-opus-5-5
# low | medium | high
LLM_EFFORT=medium
# Required for LLM_PROVIDER=anthropic; get it from the Anthropic Console
ANTHROPIC_API_KEY=
# Parallel model calls while drafting
LLM_MAX_CONCURRENCY=8
# Hard token cap per project (input + output)
LLM_MAX_TOKENS_PER_PROJECT=2000000
LLM_TIMEOUT_SECONDS=120

# --- Retrieval ---
# fastembed = local bge-small model (downloaded once, ~130 MB); hash = no download, lower quality
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Below this top retrieval score a requirement is a gap without drafting; the drafter decides above it (hash embeddings use 0.12)
RETRIEVAL_MIN_SCORE=0.35
RETRIEVAL_TOP_K=6

# --- Document tools ---
# OCR for scanned pages needs Tesseract installed (brew install tesseract)
OCR_ENABLED=true
TESSERACT_CMD=tesseract

# --- Jobs ---
# Background worker threads
JOB_WORKERS=2

# --- Frontend (read by Vite; must start with VITE_) ---
VITE_API_BASE_URL=/api
